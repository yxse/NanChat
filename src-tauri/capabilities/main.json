{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "app commands (keyring, in-app browser, notifications) restricted to the bundled main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-save-secret",
    "allow-get-secret",
    "allow-delete-secret",
    "allow-secure-storage-status",
    "allow-open-browser-window",
    "allow-show-notification",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:webview:allow-set-webview-focus",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "sql:allow-close"
  ]
}
